# --- Local (SQLite) ---
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me"

# --- Auth email (Resend) ---
# Create a free key at https://resend.com — required for real email delivery.
# Without RESEND_API_KEY, login codes are printed in the server terminal instead.
RESEND_API_KEY=
# Optional. Defaults to Resend's onboarding sender for testing:
# RESEND_FROM_EMAIL="Naano <onboarding@resend.dev>"
# For production, use a verified domain sender, e.g.:
# RESEND_FROM_EMAIL="Naano <noreply@yourdomain.com>"

# --- Vercel + Neon or Supabase (Postgres) ---
# 1. In prisma/schema.prisma set:  provider = "postgresql"
# 2. Uncomment and fill these (use the pooled URL for DATABASE_URL):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
#    ^ non-pooled / direct connection for prisma migrate
# SESSION_SECRET="long-random-string"
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Naano <noreply@yourdomain.com>"
