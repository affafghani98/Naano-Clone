# --- Neon Postgres (Vercel) ---
# In Neon: copy both connection strings.
# DATABASE_URL = pooled (hostname contains -pooler) — used by the app at runtime.
# DIRECT_URL   = direct / non-pooler — used by prisma migrate.
#
# Neon UI labels these roughly as:
#   "Pooled connection"  → DATABASE_URL
#   "Direct connection"  → DIRECT_URL
#
# Append sslmode=require if missing. For Prisma + Neon pooler, prefer:
#   ?sslmode=require&pgbouncer=true&connect_timeout=15
# on DATABASE_URL only (not on DIRECT_URL).

DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET="change-me-to-a-long-random-string"

# --- Auth email (Resend) ---
# Create a free key at https://resend.com — required for real email delivery.
# Without RESEND_API_KEY, login codes are printed in the server terminal instead.
RESEND_API_KEY=
# Optional. Defaults to Resend's onboarding sender for testing:
# RESEND_FROM_EMAIL="Naano <onboarding@resend.dev>"
# For production, use a verified domain sender, e.g.:
# RESEND_FROM_EMAIL="Naano <noreply@yourdomain.com>"

# --- Page chat + onboarding AI (Groq) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (default: openai/gpt-oss-120b)
# GROQ_MODEL="openai/gpt-oss-120b"

# --- Local note ---
# Schema provider is postgresql. Local SQLite (file:./dev.db) is no longer supported.
# Point DATABASE_URL + DIRECT_URL at Neon (or any Postgres) for `npm run dev` too.
